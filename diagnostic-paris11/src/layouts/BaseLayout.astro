---
/**
 * Gabarit commun à toutes les pages : balises SEO, données structurées,
 * cadre photo d'en-tête (navigation en onglets, titre, fil d'Ariane),
 * pied de page et barre d'actions mobile.
 *
 * En-tête : passer `hero` ({ title, lead, image }) ou fournir un slot « hero »
 * entièrement personnalisé (page d'accueil).
 */
import '@fontsource-variable/inter-tight/wght.css';
import '@fontsource-variable/inter-tight/wght-italic.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import interTightWoff2 from '@fontsource-variable/inter-tight/files/inter-tight-latin-wght-normal.woff2?url';
import '@/styles/global.css';
import { site } from '@/config/site';
import { businessSchema, breadcrumbSchema } from '@/lib/schema';
import PageFrame from '@/components/PageFrame.astro';
import Footer from '@/components/Footer.astro';
import MobileActionBar from '@/components/MobileActionBar.astro';

interface Props {
  title: string; // balise <title> (50-60 caractères idéalement)
  description: string; // meta description (140-160 caractères)
  schemas?: Record<string, unknown>[];
  breadcrumbs?: { name: string; href: string }[];
  noindex?: boolean;
  ogType?: 'website' | 'article';
  hero?: { title: string; lead?: string; image?: ImageMetadata; imagePosition?: string; actions?: boolean; devisHref?: string };
}

const { title, description, schemas = [], breadcrumbs, noindex: noindexPage = false, ogType = 'website', hero } = Astro.props;
// NOINDEX=true (variable d'environnement) : site de prévisualisation, non indexé par les moteurs.
const noindex = noindexPage || process.env.NOINDEX === 'true';
const siteUrl = (Astro.site ?? new URL('https://www.votre-domaine.fr')).toString().replace(/\/$/, '/');
const canonical = new URL(Astro.url.pathname, siteUrl).toString();
const ogImage = new URL('/og-default.png', siteUrl).toString();

const allSchemas = [businessSchema(siteUrl), ...schemas];
if (breadcrumbs?.length) {
  allSchemas.push(
    breadcrumbSchema([{ name: 'Accueil', href: '/' }, ...breadcrumbs].map((b) => ({ name: b.name, url: new URL(b.href, siteUrl).toString() })))
  );
}
---
<!doctype html>
<html lang="fr-FR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <link rel="preload" href={interTightWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="format-detection" content="telephone=no" />

    <!-- Open Graph (aperçu lors d'un partage) -->
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    {allSchemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}

    {site.plausibleDomain && (
      <script defer data-domain={site.plausibleDomain} src="https://plausible.io/js/script.js"></script>
    )}

    <!-- Active les animations uniquement si JavaScript est disponible -->
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body class="min-h-[100dvh] pb-20 antialiased sm:pb-0">
    <a href="#contenu" class="sr-only-focusable fixed top-3 left-3 z-50 rounded-full bg-ink px-4 py-2 font-semibold text-white">Aller au contenu</a>
    {Astro.slots.has('hero')
      ? <slot name="hero" />
      : <PageFrame title={hero?.title} lead={hero?.lead} image={hero?.image} imagePosition={hero?.imagePosition} actions={hero?.actions} devisHref={hero?.devisHref} breadcrumbs={breadcrumbs} />}
    <main id="contenu">
      <slot />
    </main>
    <Footer />
    <MobileActionBar />

    <script>
      // Apparition douce des blocs marqués data-reveal (IntersectionObserver, sans écouteur de scroll).
      const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if ('IntersectionObserver' in window && els.length) {
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => {
            if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
          }),
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
