---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site } from '@/config/site';
---
<BaseLayout title={`Page introuvable | ${site.name}`} description="Cette page n’existe pas ou a été déplacée." noindex>
  <section class="container-site max-w-3xl py-24 md:py-32">
    <p class="font-display text-7xl font-semibold text-accent">404</p>
    <h1 class="mt-4 text-5xl leading-[1.05]">Cette page est introuvable.</h1>
    <p class="mt-6 text-lg text-muted">Elle a peut-être été déplacée. Voici quelques pistes :</p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a href="/" class="btn btn-primary">Accueil</a>
      <a href="/diagnostics/" class="btn btn-ghost">Nos diagnostics</a>
      <a href="/devis/" class="btn btn-ghost">Demander un devis</a>
    </div>
  </section>
</BaseLayout>
