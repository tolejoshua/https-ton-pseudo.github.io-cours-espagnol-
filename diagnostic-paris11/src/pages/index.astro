---
/**
 * Page d'accueil (système de design de la maquette de référence).
 * Sections : cadre photo + barre de recherche, le cabinet + chiffres,
 * cartes photo en escalier, encart brun, diagnostics, déroulé, avis,
 * zones, FAQ, appel à l'action.
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageFrame from '@/components/PageFrame.astro';
import Icon from '@/components/Icon.astro';
import Todo from '@/components/Todo.astro';
import Reviews from '@/components/Reviews.astro';
import Faq from '@/components/Faq.astro';
import CtaBand from '@/components/CtaBand.astro';
import { site } from '@/config/site';
import { pricing, formatPrice } from '@/config/tarifs';
import { photos, diagnosticPhotos } from '@/lib/photos';
import { faqSchema } from '@/lib/schema';

const diagnostics = (await getCollection('diagnostics')).sort((a, b) => a.data.order - b.data.order);
const zones = (await getCollection('zones')).sort((a, b) => a.data.order - b.data.order);

const faq = [
  {
    q: 'Quels diagnostics faut-il pour vendre un appartement à Paris ?',
    a: 'Dans tous les cas : le DPE, l’état des risques (ERP), le mesurage loi Carrez pour un lot de copropriété et, à Paris, l’état relatif à la présence de termites. S’y ajoutent selon le bien : le plomb (immeuble construit avant 1949), l’amiante (permis de construire avant le 1er juillet 1997), l’électricité et le gaz (installations de plus de 15 ans).',
  },
  {
    q: 'Sous quel délai pouvez-vous intervenir ?',
    a: `Le rendez-vous est généralement fixé ${site.delays.appointment}, selon vos disponibilités et l’accès au logement. Le rapport complet vous est envoyé ${site.delays.report} après la visite, hors analyses de laboratoire éventuelles pour l’amiante.`,
  },
  {
    q: 'Combien coûtent les diagnostics ?',
    a: 'Le prix dépend de la surface, de l’année de construction et des diagnostics nécessaires. Consultez notre grille indicative ou demandez un devis : il est détaillé, sans engagement, et vous indique exactement les diagnostics requis.',
  },
  {
    q: 'Intervenez-vous en dehors du 11e arrondissement ?',
    a: 'Oui. Nous intervenons dans tout Paris et en petite couronne : Hauts-de-Seine, Seine-Saint-Denis et Val-de-Marne.',
  },
  {
    q: 'Comment vérifier que le diagnostiqueur est certifié ?',
    a: 'Chaque diagnostiqueur doit être certifié par un organisme accrédité pour chaque domaine qu’il réalise. Vous pouvez le vérifier gratuitement dans l’annuaire officiel des diagnostiqueurs immobiliers du ministère de la Transition écologique.',
  },
  {
    q: 'Dois-je être présent pendant la visite ?',
    a: 'Il suffit qu’une personne puisse nous donner accès à toutes les pièces, ainsi qu’aux caves, combles et parkings privatifs. Votre agent immobilier, un proche ou le gardien peuvent vous représenter.',
  },
];

// Chiffres factuels uniquement (aucune statistique inventée)
const stats = [
  { value: '24 h', label: 'Délai de remise du rapport' },
  { value: '8', label: 'Diagnostics réalisés' },
  { value: '4', label: 'Départements desservis' },
  { value: '1 sem.', label: 'Délai habituel de rendez-vous' },
];

const audiences = [
  { title: 'Particuliers', text: 'Uniquement les diagnostics réellement obligatoires pour votre bien.' },
  { title: 'Agences immobilières', text: 'Des rapports sous 24 h pour publier l’annonce sans attendre.' },
  { title: 'Syndics et gestionnaires', text: 'Interventions coordonnées dans l’immeuble, accès gardien.' },
  { title: 'Notaires', text: 'Un dossier complet et à jour pour la promesse comme pour l’acte.' },
  { title: 'Investisseurs', text: 'Une lecture claire du DPE et des règles de location.' },
];

const steps = [
  { title: 'Vous décrivez votre bien', text: 'Type, surface, année de construction, vente ou location : deux minutes en ligne ou par téléphone.' },
  { title: 'Nous fixons la visite', text: `Devis détaillé et rendez-vous proposé ${site.delays.appointment}.` },
  { title: 'Nous intervenons', text: 'Un diagnostiqueur certifié réalise tous les diagnostics en une seule visite.' },
  { title: 'Vous recevez le dossier', text: `Rapports complets ${site.delays.report}, prêts pour le notaire ou le bail.` },
];

const zoneByLabel = (label: string) => zones.find((z) => z.data.label === label);
const gallery = [
  { image: photos.facadeAngle, alt: 'Façade d’immeuble haussmannien', zone: zoneByLabel('Bastille'), h: 'h-[300px] md:h-[400px]', offset: 'md:mt-0' },
  { image: photos.interieurParis, alt: 'Salon d’un appartement parisien ancien', zone: zoneByLabel('Voltaire'), h: 'h-[300px] md:h-[340px]', offset: 'md:mt-14' },
  { image: null, alt: '', zone: null, h: 'h-[300px] md:h-[300px]', offset: 'md:mt-28' },
  { image: photos.facadesRue, alt: 'Façades d’immeubles parisiens', zone: zoneByLabel('Nation'), h: 'h-[300px] md:h-[380px]', offset: 'md:mt-6' },
];
---
<BaseLayout
  title={`Diagnostic immobilier Paris 11e | ${site.name}`}
  description="Diagnostics immobiliers à Paris 11e et en petite couronne : DPE, amiante, plomb, électricité, gaz, termites, Carrez, ERP. Diagnostiqueur certifié, rapport sous 24 h."
  schemas={[faqSchema(faq)]}
>
  <!-- CADRE PHOTO + BARRE DE RECHERCHE -->
  <PageFrame slot="hero" size="home" image={photos.heroHaussmann} imagePosition="center 30%">
    <div class="flex flex-1 flex-col justify-between px-5 pt-20 pb-5 md:px-9 md:pt-24 md:pb-7">
      <div class="max-w-4xl">
        <h1 class="text-[3rem] text-white sm:text-7xl lg:text-[5.4rem]">
          Diagnostics<br />
          <em class="block pl-[0.6em] pb-1">immobiliers à Paris</em>
        </h1>
        <p class="mt-6 max-w-[22rem] text-[0.82rem] leading-relaxed text-white/85">
          DPE, amiante, plomb, électricité, gaz, termites, Carrez : un diagnostiqueur certifié, une seule visite, le rapport {site.delays.report}. Partout à Paris et en petite couronne.
        </p>
      </div>

      <form action="/quels-diagnostics/" method="get" class="searchbar mt-10" aria-label="Trouver les diagnostics de votre bien">
        <label class="searchbar-field">
          <span class="searchbar-icon"><Icon name="tag" class="size-4" /></span>
          <span class="min-w-0 flex-1">
            <span class="searchbar-label">Opération</span>
            <select name="operation">
              <option value="vente">Vente</option>
              <option value="location">Location</option>
            </select>
          </span>
        </label>
        <label class="searchbar-field">
          <span class="searchbar-icon"><Icon name="house" class="size-4" /></span>
          <span class="min-w-0 flex-1">
            <span class="searchbar-label">Type de bien</span>
            <select name="bien">
              <option value="appartement">Appartement</option>
              <option value="maison">Maison</option>
            </select>
          </span>
        </label>
        <label class="searchbar-field">
          <span class="searchbar-icon"><Icon name="calendar-blank" class="size-4" /></span>
          <span class="min-w-0 flex-1">
            <span class="searchbar-label">Construction</span>
            <select name="construction">
              <option value="avant1949">Avant 1949</option>
              <option value="avant1997">1949 à juin 1997</option>
              <option value="apres1997">Après juillet 1997</option>
              <option value="inconnu">Je ne sais pas</option>
            </select>
          </span>
        </label>
        <label class="searchbar-field">
          <span class="searchbar-icon"><Icon name="map-pin" class="size-4" /></span>
          <span class="min-w-0 flex-1">
            <span class="searchbar-label">Localisation</span>
            <select name="localisation">
              <option value="paris">Paris</option>
              <option value="petite-couronne">Petite couronne</option>
            </select>
          </span>
        </label>
        <button type="submit" class="btn btn-primary mt-1 min-h-11 md:mt-0">Voir mes diagnostics</button>
      </form>
    </div>
  </PageFrame>

  <!-- LE CABINET + CHIFFRES -->
  <section class="container-site grid gap-8 py-20 md:grid-cols-12 md:py-28" aria-labelledby="about-title">
    <div class="md:col-span-3">
      <p class="label-sm">Le cabinet</p>
      <p class="mt-2 text-xs text-muted">
        Certifié par {site.certification.body ?? <Todo label="organisme" />}
      </p>
    </div>
    <div class="md:col-span-9">
      <h2 id="about-title" class="max-w-[46rem] text-[1.75rem] leading-[1.22] tracking-[-0.025em] md:text-[2.5rem]">
        Notre cabinet réalise <em>tous les diagnostics</em> obligatoires pour vendre ou louer à Paris, avec un rapport <em>clair</em> et une intervention <em>soignée</em>.
      </h2>
      <dl class="mt-14 grid grid-cols-2 gap-x-6 gap-y-10 md:grid-cols-4">
        {stats.map((s, i) => (
          <div data-reveal style={`--i:${i}`}>
            <dt class="sr-only">{s.label}</dt>
            <dd class="text-[2.6rem] font-light italic leading-none tracking-[-0.04em] md:text-[3.4rem]">{s.value}</dd>
            <dd class="mt-3 text-xs text-muted">{s.label}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- CARTES PHOTO EN ESCALIER -->
  <section class="container-site" aria-label="Nos quartiers et nos diagnostics">
    <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 md:grid-cols-4 md:items-start">
      {gallery.map((g, i) => (
        <li class={g.offset} data-reveal style={`--i:${i}`}>
          {g.image && g.zone ? (
            <a href={`/zones/${g.zone.id}/`} class:list={['photo-zoom group relative block overflow-hidden rounded-[16px]', g.h]}>
              <Image src={g.image} alt={g.alt} widths={[400, 640, 800]} sizes="(min-width: 768px) 25vw, 100vw" class="h-full w-full object-cover" />
              <span class="tag tag-glass absolute bottom-4 left-4">{g.zone.data.label}</span>
            </a>
          ) : (
            <a href="/diagnostics/" class:list={['group relative flex flex-col justify-between overflow-hidden rounded-[16px] bg-brown p-6 text-white', g.h]}>
              <Image src={photos.toitsMansardes} alt="" widths={[400, 640]} sizes="25vw" class="absolute inset-0 -z-0 h-full w-full object-cover opacity-30" />
              <span class="relative flex items-start justify-between gap-4">
                <span class="text-[1.6rem] leading-[1.05] tracking-[-0.03em]">Nos <em class="serif-em">diagnostics</em></span>
                <span class="round-arrow shrink-0"><Icon name="arrow-up-right" class="size-4" /></span>
              </span>
              <span class="relative text-xs text-on-night-muted">DPE, amiante, plomb, électricité, gaz, termites, Carrez, ERP</span>
            </a>
          )}
        </li>
      ))}
    </ul>
  </section>

  <!-- ENCART BRUN : PARTICULIERS ET PROFESSIONNELS -->
  <section class="container-site py-20 md:py-28" aria-labelledby="pro-title">
    <div class="relative grid overflow-hidden rounded-[22px] bg-brown text-white md:grid-cols-12" data-reveal>
      <div class="relative z-10 flex flex-col justify-between gap-10 p-7 md:col-span-6 md:p-12">
        <div>
          <h2 id="pro-title" class="text-[2.6rem] md:text-[3.6rem]">Particuliers <br /><em>et professionnels</em></h2>
          <p class="mt-5 max-w-md text-sm leading-relaxed text-on-night-muted">
            Vendeurs, bailleurs, agences, syndics, notaires ou investisseurs : nous adaptons l’intervention et le format des rapports à votre situation.
          </p>
        </div>
        <ul class="grid gap-x-8 gap-y-4 sm:grid-cols-2">
          {audiences.map((a) => (
            <li class="border-t border-white/15 pt-3">
              <p class="text-sm font-medium">{a.title}</p>
              <p class="mt-1 text-xs leading-relaxed text-on-night-muted">{a.text}</p>
            </li>
          ))}
        </ul>
        <a href="/devis/" class="btn btn-white self-start">Demander un devis</a>
      </div>
      <div class="relative min-h-[280px] md:col-span-6 md:min-h-full">
        <Image src={photos.cabinetLumiere} alt="" widths={[480, 800, 1100]} sizes="(min-width: 768px) 50vw, 100vw" class="absolute inset-0 h-full w-full object-cover" />
        <div class="absolute inset-y-0 left-0 hidden w-1/3 bg-gradient-to-r from-brown to-transparent md:block" aria-hidden="true"></div>
      </div>
    </div>
  </section>

  <!-- DIAGNOSTICS (cartes « biens » de la maquette) -->
  <section class="container-site pb-20 md:pb-28" aria-labelledby="diag-title">
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <h2 id="diag-title" class="text-[2.6rem] md:text-[3.4rem]">Nos <em>diagnostics</em></h2>
      <p class="max-w-sm text-sm text-muted">Chaque diagnostic avec sa durée de validité et son prix de départ{pricing.isExample ? ' (prix d’exemple)' : ''}.</p>
    </div>
    <ul class="mt-10 grid gap-x-4 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
      {diagnostics.map((d, i) => (
        <li data-reveal style={`--i:${i % 4}`}>
          <a href={`/diagnostics/${d.id}/`} class="group block">
            <div class="photo-zoom overflow-hidden rounded-[16px]">
              <Image src={diagnosticPhotos[d.id]} alt="" widths={[400, 640, 800]} sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw" class="aspect-[4/3] w-full object-cover" />
            </div>
            <p class="mt-4 text-xs text-muted">
              dès {formatPrice(pricing.single[d.id] ?? 0)}
              {pricing.isExample && <span class="todo ml-1">exemple</span>}
            </p>
            <h3 class="mt-1 text-xl tracking-[-0.02em] group-hover:underline group-hover:underline-offset-4">{d.data.shortName}</h3>
            <p class="mt-3 flex flex-wrap gap-1.5">
              <span class="tag">Validité {d.data.validityHeadline.replace('*', '')}</span>
              <span class="tag">{d.id === 'termites' ? 'Vente' : 'Vente et location'}</span>
            </p>
          </a>
        </li>
      ))}
    </ul>
    <a href="/diagnostics/" class="btn btn-ghost btn-block mt-12">Voir le détail des obligations</a>
  </section>

  <!-- DÉROULÉ -->
  <section class="bg-surface py-20 md:py-28" aria-labelledby="process-title">
    <div class="container-site">
      <h2 id="process-title" class="max-w-2xl text-[2.6rem] md:text-[3.4rem]">Comment se passe <em>votre dossier</em></h2>
      <ol class="mt-12 grid gap-4 md:grid-cols-4">
        {steps.map((s, i) => (
          <li class="flex flex-col rounded-[16px] bg-white p-6" data-reveal style={`--i:${i}`}>
            <span class="text-[2.4rem] font-light italic leading-none tracking-[-0.04em]">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-10 text-lg">{s.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <Reviews />

  <!-- ZONES -->
  <section class="frame" aria-labelledby="zones-title">
    <Image src={photos.toitsMansardes} alt="" widths={[640, 1280, 1600]} sizes="100vw" class="frame-media" />
    <div class="absolute inset-0 -z-[1] bg-black/45" aria-hidden="true"></div>
    <div class="grid gap-10 px-6 py-16 md:grid-cols-12 md:items-end md:px-12 md:py-24">
      <div class="md:col-span-6">
        <h2 id="zones-title" class="text-[2.6rem] text-white md:text-[3.6rem]">Depuis le 11e, <em>tout Paris</em></h2>
        <p class="mt-5 max-w-md text-sm leading-relaxed text-white/85">Installés avenue Philippe Auguste, entre Nation et Charonne, nous intervenons dans chaque arrondissement et en petite couronne.</p>
        <a href="/zones/" class="btn btn-white mt-8">Voir les zones desservies</a>
      </div>
      <ul class="flex flex-wrap gap-2 md:col-span-6 md:justify-end">
        {zones.map((z) => (
          <li><a href={`/zones/${z.id}/`} class="inline-flex min-h-10 items-center rounded-full bg-white/15 px-4 text-sm text-white backdrop-blur-md hover:bg-white hover:text-ink">{z.data.label}</a></li>
        ))}
      </ul>
    </div>
  </section>

  <Faq items={faq} />
  <CtaBand />
</BaseLayout>
