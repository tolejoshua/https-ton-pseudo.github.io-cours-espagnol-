---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { site, phoneHref } from '@/config/site';
---
<BaseLayout title={`Demande envoyée | ${site.name}`} description="Votre demande a bien été envoyée." noindex hero={{ title: 'Merci, votre demande <em>est bien envoyée.</em>' }}>
  <section class="container-site max-w-3xl py-16 md:py-20">
    <p class="text-lg text-muted">Nous revenons vers vous rapidement. En cas d’urgence, n’hésitez pas à nous appeler{site.contact.showPhone && <> au <a href={phoneHref} class="link font-semibold">{site.contact.phoneDisplay}</a></>}.</p>
    <div class="mt-10 flex flex-col gap-3 sm:flex-row">
      <a href="/" class="btn btn-ghost">Retour à l’accueil</a>
      <a href="/blog/" class="btn btn-ghost">Lire nos conseils</a>
    </div>
  </section>
</BaseLayout>
