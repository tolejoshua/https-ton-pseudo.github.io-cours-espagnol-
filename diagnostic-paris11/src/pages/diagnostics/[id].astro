---
/**
 * Modèle commun aux pages de diagnostic.
 * Le contenu vient de src/content/diagnostics/<id>.md
 */
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Faq from '@/components/Faq.astro';
import CtaBand from '@/components/CtaBand.astro';
import { pricing, formatPrice } from '@/config/tarifs';
import { faqSchema, serviceSchema } from '@/lib/schema';
import { diagnosticPhotos } from '@/lib/photos';
import { accentTitle } from '@/lib/accent';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const entries = await getCollection('diagnostics');
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const all = await getCollection('diagnostics');
const related = d.related.map((id) => all.find((x) => x.id === id)).filter(Boolean);
const price = pricing.single[entry.id];
const siteUrl = (Astro.site ?? new URL('https://www.votre-domaine.fr')).toString();
const url = new URL(Astro.url.pathname, siteUrl).toString();
---
<BaseLayout
  title={d.seoTitle}
  description={d.description}
  breadcrumbs={[{ name: 'Diagnostics', href: '/diagnostics/' }, { name: d.shortName, href: `/diagnostics/${entry.id}/` }]}
  schemas={[serviceSchema({ name: d.title, description: d.description, url, siteUrl }), ...(d.faq.length ? [faqSchema(d.faq)] : [])]}
  hero={{ title: accentTitle(d.title), lead: d.summary, image: diagnosticPhotos[entry.id], actions: true, devisHref: `/devis/?diagnostics=${entry.id}` }}
>
  <section class="container-site grid gap-12 py-16 md:py-20 lg:grid-cols-12">
    <article class="prose-site lg:col-span-8">
      <Content />
    </article>

    <!-- Fiche synthétique (carte grise, façon fiche de bien) -->
    <aside class="self-start rounded-[16px] bg-surface p-7 lg:sticky lg:top-6 lg:col-span-4" aria-label="L’essentiel">
      <p class="label-sm">L’essentiel</p>
      <dl class="mt-4 grid gap-5 text-[0.92rem]">
        <div>
          <dt class="text-xs text-muted">Biens concernés</dt>
          <dd class="mt-1">{d.concerned}</dd>
        </div>
        <div class="border-t border-line pt-5">
          <dt class="text-xs text-muted">En cas de vente</dt>
          <dd class="mt-1">{d.sale}</dd>
        </div>
        <div class="border-t border-line pt-5">
          <dt class="text-xs text-muted">En cas de location</dt>
          <dd class="mt-1">{d.rental}</dd>
        </div>
        {price && (
          <div class="border-t border-line pt-5">
            <dt class="text-xs text-muted">Prix indicatif</dt>
            <dd class="mt-1">
              dès <span class="text-[2rem] font-light italic tracking-[-0.03em]">{formatPrice(price)}</span>
              {pricing.isExample && <span class="todo ml-2">exemple</span>}
            </dd>
          </div>
        )}
      </dl>
      <p class="mt-6 flex flex-wrap gap-1.5"><span class="tag">Validité {d.validityHeadline.replace('*', '')}</span></p>
      <a href={`/devis/?diagnostics=${entry.id}`} class="btn btn-primary btn-block mt-6">Demander un devis</a>
      <a href="/tarifs/" class="mt-3 block text-center text-xs text-muted underline underline-offset-2 hover:text-ink">Voir la grille tarifaire</a>
    </aside>
  </section>

  <div class="container-site">
    {d.sources.length > 0 && (
      <aside class="max-w-[68ch] rounded-[16px] border border-line p-6 text-sm" aria-labelledby="sources-title">
        <h2 id="sources-title" class="font-sans text-base font-bold">Références réglementaires</h2>
        <ul class="mt-3 grid gap-2 text-muted">
          {d.sources.map((s) => (
            <li>{s.url ? <a class="link" href={s.url} target="_blank" rel="noopener">{s.label}</a> : s.label}</li>
          ))}
        </ul>
        <p class="mt-4 text-muted">Informations à jour en octobre 2026. Elles ne remplacent pas l’avis du diagnostiqueur sur votre situation.</p>
      </aside>
    )}
  </div>

  <Faq items={d.faq} />

  {related.length > 0 && (
    <section class="container-site pb-16 md:pb-24" aria-labelledby="related-title">
      <h2 id="related-title" class="text-[2.4rem] md:text-[3rem]">Souvent <em>réalisés ensemble</em></h2>
      <ul class="mt-8 grid gap-x-4 gap-y-8 sm:grid-cols-3">
        {related.map((r) => r && (
          <li>
            <a href={`/diagnostics/${r.id}/`} class="group block">
              <div class="photo-zoom overflow-hidden rounded-[16px]">
                <Image src={diagnosticPhotos[r.id]} alt="" widths={[400, 640]} sizes="(min-width: 640px) 33vw, 100vw" class="aspect-[4/3] w-full object-cover" />
              </div>
              <h3 class="mt-4 text-xl group-hover:underline group-hover:underline-offset-4">{r.data.shortName}</h3>
              <p class="mt-2"><span class="tag">Validité {r.data.validityHeadline.replace('*', '')}</span></p>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <CtaBand />
</BaseLayout>
