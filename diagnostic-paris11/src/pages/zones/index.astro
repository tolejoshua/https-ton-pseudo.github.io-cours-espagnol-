---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import CtaBand from '@/components/CtaBand.astro';
import { site } from '@/config/site';

const zones = (await getCollection('zones')).sort((a, b) => a.data.order - b.data.order);
const quartiers = zones.filter((z) => z.data.kind === 'quartier');
const autres = zones.filter((z) => z.data.kind !== 'quartier');
---
<BaseLayout
  title={`Zones desservies, Paris et petite couronne | ${site.name}`}
  description="Diagnostiqueur immobilier basé à Paris 11e : interventions dans tout Paris, les Hauts-de-Seine, la Seine-Saint-Denis et le Val-de-Marne."
  breadcrumbs={[{ name: 'Zones desservies', href: '/zones/' }]}
>
  <section class="container-site pt-10 pb-14 md:pt-14">
    <h1 class="max-w-3xl text-5xl leading-[1.05] md:text-6xl">Zones desservies</h1>
    <p class="mt-6 max-w-2xl text-lg text-muted">
      Installés au {site.address.street}, nous intervenons en priorité dans le 11e et l’est parisien, et dans tout Paris et la petite couronne.
    </p>
  </section>

  <section class="container-site pb-16" aria-labelledby="q-title">
    <h2 id="q-title" class="text-3xl md:text-4xl">Le 11e arrondissement</h2>
    <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {quartiers.map((z, i) => (
        <li data-reveal style={`--i:${i % 3}`}>
          <a href={`/zones/${z.id}/`} class="group flex h-full flex-col rounded-[6px] border border-line bg-surface p-6 hover:border-line-strong">
            <span class="font-display text-2xl font-semibold group-hover:text-accent">{z.data.label}</span>
            <span class="mt-2 text-sm text-muted">{z.data.places.slice(0, 4).join(', ')}</span>
            <Icon name="arrow-right" class="mt-auto size-5 pt-4 text-accent" />
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="bg-night text-on-night" aria-labelledby="pc-title">
    <div class="container-site py-16 md:py-20">
      <h2 id="pc-title" class="text-3xl md:text-4xl">Paris et petite couronne</h2>
      <ul class="mt-8 grid gap-4 md:grid-cols-2">
        {autres.map((z) => (
          <li>
            <a href={`/zones/${z.id}/`} class="group block h-full rounded-[6px] border border-white/15 p-6 hover:border-accent-on-night">
              <span class="font-display text-2xl font-semibold group-hover:text-accent-on-night">{z.data.label}</span>
              <span class="mt-2 block text-sm text-on-night-muted">{z.data.places.slice(0, 6).join(', ')}…</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <div class="pt-20 md:pt-28"><CtaBand /></div>
</BaseLayout>
