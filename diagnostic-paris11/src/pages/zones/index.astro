---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { photos, zonePhoto } from '@/lib/photos';
import Icon from '@/components/Icon.astro';
import CtaBand from '@/components/CtaBand.astro';
import { site } from '@/config/site';

const zones = (await getCollection('zones')).sort((a, b) => a.data.order - b.data.order);
const quartiers = zones.filter((z) => z.data.kind === 'quartier');
const autres = zones.filter((z) => z.data.kind !== 'quartier');
---
<BaseLayout
  title={`Zones desservies, Paris et petite couronne | ${site.name}`}
  description="Diagnostiqueur immobilier basé à Paris 11e : interventions dans tout Paris, les Hauts-de-Seine, la Seine-Saint-Denis et le Val-de-Marne."
  breadcrumbs={[{ name: 'Zones desservies', href: '/zones/' }]}
  hero={{ title: 'Zones <em>desservies</em>', lead: `Installés au ${site.address.street}, nous intervenons en priorité dans le 11e et l’est parisien, et dans tout Paris et la petite couronne.`, image: photos.pageZones }}
>
  <!-- Quartiers du 11e : cartes photo -->
  <section class="container-site py-16 md:py-20" aria-labelledby="q-title">
    <h2 id="q-title" class="text-[2.4rem] md:text-[3.2rem]">Le 11e <em>arrondissement</em></h2>
    <ul class="mt-10 grid gap-x-4 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
      {quartiers.map((z, i) => (
        <li data-reveal style={`--i:${i % 3}`}>
          <a href={`/zones/${z.id}/`} class="group block">
            <div class="photo-zoom relative overflow-hidden rounded-[16px]">
              <Image src={zonePhoto(z.data.order)} alt="" widths={[400, 640, 800]} sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw" class="aspect-[4/3] w-full object-cover" />
              <span class="round-arrow absolute top-4 right-4"><Icon name="arrow-up-right" class="size-4" /></span>
            </div>
            <h3 class="mt-4 text-xl group-hover:underline group-hover:underline-offset-4">{z.data.label}</h3>
            <p class="mt-1 text-sm text-muted">{z.data.places.slice(0, 4).join(', ')}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- Paris et petite couronne : encart brun -->
  <section class="container-site pb-16 md:pb-24" aria-labelledby="pc-title">
    <div class="rounded-[22px] bg-brown p-7 text-white md:p-12">
      <h2 id="pc-title" class="text-[2.4rem] md:text-[3.2rem]">Paris <em>et petite couronne</em></h2>
      <ul class="mt-10 grid gap-x-8 md:grid-cols-2">
        {autres.map((z) => (
          <li class="border-t border-white/15">
            <a href={`/zones/${z.id}/`} class="group flex items-start justify-between gap-6 py-6">
              <span>
                <span class="block text-2xl tracking-[-0.02em] group-hover:underline group-hover:underline-offset-4">{z.data.label}</span>
                <span class="mt-2 block text-sm text-on-night-muted">{z.data.places.slice(0, 6).join(', ')}…</span>
              </span>
              <span class="round-arrow shrink-0"><Icon name="arrow-up-right" class="size-4" /></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
