---
/**
 * Illustration du hero : élévation d'une façade parisienne de type
 * haussmannien, tracée comme un plan (bleu nuit, traits ivoire, cotes cuivre).
 * Les repères 1, 2, 3 renvoient à la légende affichée sous le dessin.
 * Chaque trait se dessine à l'affichage (désactivé si l'utilisateur
 * préfère réduire les animations).
 */
const bays = [96, 168, 240, 312, 384];
const floors = [
  { y: 458, h: 46 }, // 1er
  { y: 390, h: 50 }, // 2e (étage noble)
  { y: 324, h: 46 }, // 3e
  { y: 260, h: 44 }, // 4e
  { y: 196, h: 44 }, // 5e
];
let d = 0;
const delay = () => (d += 18);
---
<svg viewBox="0 0 520 640" class="draw h-auto w-full" role="img" aria-labelledby="facade-title">
  <title id="facade-title">Plan d'élévation d'une façade d'immeuble parisien avec cotes et repères de diagnostics</title>
  <g fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" class="text-on-night">
    <!-- Sol et silhouette -->
    <line x1="30" y1="600" x2="470" y2="600" pathLength="1" style={`--d:${delay()}`} />
    <rect x="60" y="180" width="360" height="420" pathLength="1" style={`--d:${delay()}`} />
    <!-- Corniche -->
    <line x1="52" y1="180" x2="428" y2="180" pathLength="1" style={`--d:${delay()}`} />
    <line x1="56" y1="174" x2="424" y2="174" pathLength="1" style={`--d:${delay()}`} />
    <!-- Toit mansardé et lucarnes -->
    <polyline points="64,174 92,110 388,110 416,174" pathLength="1" style={`--d:${delay()}`} />
    {[132, 240, 348].map((x) => (
      <path d={`M${x - 16} 168 V132 Q${x} 116 ${x + 16} 132 V168`} pathLength="1" style={`--d:${delay()}`} />
    ))}
    <rect x="120" y="86" width="22" height="24" pathLength="1" style={`--d:${delay()}`} />
    <rect x="338" y="80" width="26" height="30" pathLength="1" style={`--d:${delay()}`} />
    <!-- Bandeaux d'étage -->
    {[520, 452, 384, 318, 254].map((y) => (
      <line x1="60" y1={y} x2="420" y2={y} stroke-width="0.8" opacity="0.55" pathLength="1" style={`--d:${delay()}`} />
    ))}
    <!-- Fenêtres -->
    {floors.map((f) => bays.map((x) => (
      <g>
        <rect x={x - 15} y={f.y} width="30" height={f.h} pathLength="1" style={`--d:${delay()}`} />
        <line x1={x} y1={f.y} x2={x} y2={f.y + f.h} stroke-width="0.7" opacity="0.6" pathLength="1" style={`--d:${d}`} />
      </g>
    )))}
    <!-- Balcons filants (2e et 5e étages) -->
    {[446, 248].map((y) => (
      <g>
        <line x1="62" y1={y} x2="418" y2={y} stroke-width="1.8" pathLength="1" style={`--d:${delay()}`} />
        <line x1="62" y1={y - 12} x2="418" y2={y - 12} stroke-width="0.8" pathLength="1" style={`--d:${delay()}`} />
      </g>
    ))}
    <!-- Rez-de-chaussée : arcades et porte cochère -->
    {[96, 168, 312, 384].map((x) => (
      <path d={`M${x - 24} 600 V552 Q${x} 528 ${x + 24} 552 V600`} pathLength="1" style={`--d:${delay()}`} />
    ))}
    <path d="M214 600 V548 Q240 518 266 548 V600" stroke-width="1.6" pathLength="1" style={`--d:${delay()}`} />
  </g>

  <!-- Cotes (cuivre) -->
  <g fill="none" stroke="currentColor" stroke-width="1" class="text-accent-on-night">
    <line x1="450" y1="600" x2="450" y2="110" pathLength="1" style={`--d:${delay()}`} />
    <line x1="443" y1="600" x2="457" y2="600" pathLength="1" style={`--d:${d}`} />
    <line x1="443" y1="110" x2="457" y2="110" pathLength="1" style={`--d:${d}`} />
    <line x1="60" y1="620" x2="420" y2="620" pathLength="1" style={`--d:${delay()}`} />
    <line x1="60" y1="613" x2="60" y2="627" pathLength="1" style={`--d:${d}`} />
    <line x1="420" y1="613" x2="420" y2="627" pathLength="1" style={`--d:${d}`} />
  </g>

  <!-- Repères de la légende -->
  <g class="fade-late" font-family="Manrope Variable, sans-serif" font-size="13" font-weight="700" text-anchor="middle">
    {[
      { n: '1', x: 312, y: 412 },
      { n: '2', x: 240, y: 142 },
      { n: '3', x: 168, y: 482 },
    ].map((m) => (
      <g>
        <circle cx={m.x} cy={m.y} r="12" class="text-accent-on-night" fill="currentColor" />
        <text x={m.x} y={m.y + 4.5} fill="#0f1d2e">{m.n}</text>
      </g>
    ))}
  </g>
</svg>
