---
/**
 * Plan d'appartement schématique avec lignes de cote : rappel visuel
 * du mesurage (loi Carrez / Boutin). Purement décoratif.
 */
interface Props { class?: string }
const { class: className = '' } = Astro.props;
---
<svg viewBox="0 0 420 300" class={`h-auto w-full ${className}`} aria-hidden="true" focusable="false">
  <g fill="none" stroke="currentColor" stroke-linecap="square">
    <!-- Murs porteurs -->
    <path d="M40 40 H380 V260 H40 Z" stroke-width="5" />
    <!-- Cloisons -->
    <path d="M200 40 V150 M200 190 V260 M40 160 H120 M150 160 H200 M290 40 V120 M290 160 V260 M290 120 H380" stroke-width="2.5" />
    <!-- Ouvertures (portes) -->
    <path d="M120 160 A30 30 0 0 1 150 130" stroke-width="1" opacity="0.6" />
    <path d="M200 150 A40 40 0 0 0 240 190" stroke-width="1" opacity="0.6" />
    <path d="M290 120 A40 40 0 0 1 330 160" stroke-width="1" opacity="0.6" />
    <!-- Fenêtres -->
    <path d="M80 40 H160 M240 40 H275 M310 260 H360 M90 260 H170" stroke-width="7" class="text-bg" stroke="currentColor" />
    <path d="M80 40 H160 M240 40 H275 M310 260 H360 M90 260 H170" stroke-width="1" />
  </g>
  <!-- Cotes -->
  <g fill="none" stroke="currentColor" stroke-width="1" class="text-accent">
    <path d="M40 18 H380 M40 12 V24 M380 12 V24" />
    <path d="M402 40 V260 M396 40 H408 M396 260 H408" />
  </g>
  <g font-family="Manrope Variable, sans-serif" font-size="12" font-weight="600" class="text-muted" fill="currentColor">
    <text x="70" y="105">Séjour</text>
    <text x="226" y="96">Cuisine</text>
    <text x="310" y="88">Bains</text>
    <text x="70" y="215">Chambre</text>
    <text x="222" y="230">Entrée</text>
    <text x="310" y="215">Chambre</text>
  </g>
</svg>
