---
/** Fil d'Ariane visible (le balisage JSON-LD est ajouté par le gabarit). */
interface Props { items: { name: string; href: string }[] }
const { items } = Astro.props;
---
<nav aria-label="Fil d'Ariane" class="container-site pt-6 text-sm text-muted">
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
    <li><a href="/" class="hover:text-ink">Accueil</a></li>
    {items.map((it, i) => (
      <li class="flex items-center gap-2">
        <span aria-hidden="true">/</span>
        {i === items.length - 1
          ? <span aria-current="page" class="text-ink">{it.name}</span>
          : <a href={it.href} class="hover:text-ink">{it.name}</a>}
      </li>
    ))}
  </ol>
</nav>
