---
/**
 * Questions fréquentes en accordéon accessible (<details> natif, sans JS).
 * Le balisage FAQPage est ajouté par la page appelante.
 */
import Icon from './Icon.astro';
interface Props { items: { q: string; a: string }[]; title?: string; id?: string }
const { items, title = 'Questions <em>fréquentes</em>', id = 'faq' } = Astro.props;
---
{items.length > 0 && (
  <section aria-labelledby={`${id}-title`} class="container-site py-16 md:py-24">
    <div class="grid gap-10 md:grid-cols-12">
      <div class="md:col-span-4">
        <p class="label-sm">FAQ</p>
        <h2 id={`${id}-title`} class="mt-3 text-[2.6rem] md:text-[3.4rem]" set:html={title} />
      </div>
      <div class="md:col-span-8">
        {items.map((f, i) => (
          <details class="group border-b border-line" data-reveal style={`--i:${i}`}>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-[1.05rem] font-medium tracking-[-0.01em] [&::-webkit-details-marker]:hidden">
              <span>{f.q}</span>
              <span class="inline-flex size-8 shrink-0 items-center justify-center rounded-full bg-surface transition-transform duration-300 group-open:rotate-45">
                <Icon name="plus" class="size-4" />
              </span>
            </summary>
            <p class="max-w-[62ch] pb-6 leading-relaxed text-muted">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
)}
