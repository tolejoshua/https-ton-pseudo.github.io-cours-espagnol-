---
/**
 * Questions fréquentes en accordéon accessible (<details> natif, sans JS).
 * Le balisage FAQPage est ajouté par la page appelante.
 */
import Icon from './Icon.astro';
interface Props { items: { q: string; a: string }[]; title?: string; id?: string }
const { items, title = 'Questions fréquentes', id = 'faq' } = Astro.props;
---
{items.length > 0 && (
  <section aria-labelledby={`${id}-title`} class="container-site py-20 md:py-28">
    <div class="grid gap-10 md:grid-cols-12">
      <h2 id={`${id}-title`} class="text-4xl leading-tight md:col-span-4 md:text-5xl">{title}</h2>
      <div class="md:col-span-8">
        {items.map((f, i) => (
          <details class="group border-b border-line py-1" data-reveal style={`--i:${i}`}>
            <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-5 text-lg font-semibold [&::-webkit-details-marker]:hidden">
              <span>{f.q}</span>
              <Icon name="caret-down" class="mt-1 size-5 shrink-0 text-accent transition-transform duration-300 group-open:rotate-180" />
            </summary>
            <p class="max-w-[65ch] pb-6 leading-relaxed text-muted">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
)}
