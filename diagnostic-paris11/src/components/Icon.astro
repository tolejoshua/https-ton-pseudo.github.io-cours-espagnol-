---
/**
 * Icône Phosphor (bibliothèque open source, style « regular »).
 * Usage : <Icon name="phone" class="size-5" />
 * Pour ajouter une icône : l'importer ci-dessous (liste sur phosphoricons.com).
 */
import arrowRight from '@phosphor-icons/core/assets/regular/arrow-right.svg?raw';
import arrowUpRight from '@phosphor-icons/core/assets/regular/arrow-up-right.svg?raw';
import bugBeetle from '@phosphor-icons/core/assets/regular/bug-beetle.svg?raw';
import calendarCheck from '@phosphor-icons/core/assets/regular/calendar-check.svg?raw';
import caretDown from '@phosphor-icons/core/assets/regular/caret-down.svg?raw';
import check from '@phosphor-icons/core/assets/regular/check.svg?raw';
import clipboardText from '@phosphor-icons/core/assets/regular/clipboard-text.svg?raw';
import clock from '@phosphor-icons/core/assets/regular/clock.svg?raw';
import envelope from '@phosphor-icons/core/assets/regular/envelope-simple.svg?raw';
import fileText from '@phosphor-icons/core/assets/regular/file-text.svg?raw';
import flame from '@phosphor-icons/core/assets/regular/flame.svg?raw';
import gauge from '@phosphor-icons/core/assets/regular/gauge.svg?raw';
import info from '@phosphor-icons/core/assets/regular/info.svg?raw';
import lightning from '@phosphor-icons/core/assets/regular/lightning.svg?raw';
import list from '@phosphor-icons/core/assets/regular/list.svg?raw';
import magnifyingGlass from '@phosphor-icons/core/assets/regular/magnifying-glass.svg?raw';
import mapPin from '@phosphor-icons/core/assets/regular/map-pin.svg?raw';
import mapTrifold from '@phosphor-icons/core/assets/regular/map-trifold.svg?raw';
import paintRoller from '@phosphor-icons/core/assets/regular/paint-roller.svg?raw';
import phone from '@phosphor-icons/core/assets/regular/phone.svg?raw';
import ruler from '@phosphor-icons/core/assets/regular/ruler.svg?raw';
import sealCheck from '@phosphor-icons/core/assets/regular/seal-check.svg?raw';
import shieldCheck from '@phosphor-icons/core/assets/regular/shield-check.svg?raw';
import star from '@phosphor-icons/core/assets/fill/star-fill.svg?raw';
import timer from '@phosphor-icons/core/assets/regular/timer.svg?raw';
import warning from '@phosphor-icons/core/assets/regular/warning.svg?raw';
import x from '@phosphor-icons/core/assets/regular/x.svg?raw';
import plus from '@phosphor-icons/core/assets/regular/plus.svg?raw';
import house from '@phosphor-icons/core/assets/regular/house-simple.svg?raw';
import tag from '@phosphor-icons/core/assets/regular/tag.svg?raw';
import calendarBlank from '@phosphor-icons/core/assets/regular/calendar-blank.svg?raw';

const icons: Record<string, string> = {
  'arrow-right': arrowRight,
  'arrow-up-right': arrowUpRight,
  'bug-beetle': bugBeetle,
  'calendar-check': calendarCheck,
  'caret-down': caretDown,
  check,
  'clipboard-text': clipboardText,
  clock,
  envelope,
  'file-text': fileText,
  flame,
  gauge,
  info,
  lightning,
  list,
  'magnifying-glass': magnifyingGlass,
  'map-pin': mapPin,
  'map-trifold': mapTrifold,
  'paint-roller': paintRoller,
  phone,
  ruler,
  'seal-check': sealCheck,
  'shield-check': shieldCheck,
  star,
  timer,
  warning,
  x,
  plus,
  house,
  tag,
  'calendar-blank': calendarBlank,
};

interface Props { name: string; class?: string; label?: string }
const { name, class: className = 'size-5', label } = Astro.props;
const raw = icons[name];
if (!raw) throw new Error(`Icône inconnue : ${name}`);
// On retire les dimensions fixes et on applique la couleur du texte courant.
const svg = raw
  .replace(/\s(width|height)="[^"]*"/g, '')
  .replace('<svg', `<svg class="${className}" fill="currentColor" ${label ? `role="img" aria-label="${label}"` : 'aria-hidden="true" focusable="false"'}`);
---
<Fragment set:html={svg} />
