---
/**
 * Marque provisoire : monogramme géométrique (un carré de plan et une cote).
 * À remplacer par le logo définitif du cabinet le moment venu.
 */
import { site } from '@/config/site';
interface Props { tone?: 'default' | 'night' }
const { tone = 'default' } = Astro.props;
const initial = site.name.replace(/^Cabinet\s+/i, '').charAt(0).toUpperCase();
---
<a href="/" class="group inline-flex items-center gap-3" aria-label={`${site.name}, accueil`}>
  <svg viewBox="0 0 40 40" class="size-10 shrink-0" aria-hidden="true">
    <rect x="1.5" y="1.5" width="37" height="37" rx="6" fill="none" stroke="currentColor" stroke-width="1.5" class={tone === 'night' ? 'text-on-night' : 'text-ink'} />
    <path d="M7 33h26M7 31v4M33 31v4" stroke="currentColor" stroke-width="1.2" class="text-accent" fill="none" />
    <text x="20" y="25" text-anchor="middle" font-family="Cormorant Garamond, serif" font-size="21" font-weight="600" fill="currentColor" class={tone === 'night' ? 'text-on-night' : 'text-ink'}>{initial}</text>
  </svg>
  <span class="flex flex-col leading-tight whitespace-nowrap">
    <span class={`font-display text-[1.3rem] font-semibold ${tone === 'night' ? 'text-on-night' : 'text-ink'}`}>{site.name}</span>
    <span class={`text-[0.72rem] font-semibold tracking-[0.08em] ${tone === 'night' ? 'text-on-night-muted' : 'text-muted'}`}>{site.descriptor}</span>
  </span>
</a>
